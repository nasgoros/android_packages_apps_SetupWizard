// The inherited Lineage product still requests this module by name. Satisfy
// that reference without building or installing an APK, permissions, resources,
// receivers, or setup activities. Do not override AOSP Provision: vanilla
// builds need it, and the GApps installer replaces it when adding Google setup.
phony {
    name: "LineageSetupWizard",
}
